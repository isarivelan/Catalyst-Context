# Cognite Data Fusion — Entra ID client credentials
# Matches cognite-toolkit generated env names, plus CDF_* aliases.

CDF_CLUSTER=
CDF_PROJECT=
CDF_URL=

PROVIDER=entra_id
LOGIN_FLOW=client_credentials

# Required — fill from your app registration
IDP_TENANT_ID=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# Optional. Default token URL is login.microsoftonline.com/{IDP_TENANT_ID}/oauth2/v2.0/token
# IDP_TOKEN_URL=
# IDP_AUDIENCE=
# IDP_SCOPES=https://aw-was-gp-001.cognitedata.com/.default

# Optional aliases (used if IDP_* are empty)
# CDF_TENANT_ID=
# CDF_CLIENT_ID=
# CDF_CLIENT_SECRET=
# CDF_BASE_URL=
# CDF_TOKEN_URL=

# Optional ingestion principal (used if IDP_CLIENT_ID/SECRET are empty)
# INGESTION_CLIENT_ID=
# INGESTION_CLIENT_SECRET=
