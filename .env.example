# Cognite Data Fusion (OIDC client credentials)
# Docs: https://docs.cognite.com/dev/sdks/python/python_auth_oidc

CDF_PROJECT=
CDF_CLUSTER=api
CDF_TENANT_ID=
CDF_CLIENT_ID=
CDF_CLIENT_SECRET=

# Optional override. Default: https://{CDF_CLUSTER}.cognitedata.com
# CDF_BASE_URL=https://api.cognitedata.com

# Optional Entra token URL override.
# CDF_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
